INCLUDE [    set supplyYFunc {};    if { {<Unused>} != {} }    {       set supplyYFunc {@Coordinate(REJECTABLE,y,"<Unused>",FLATTEN_AGGREGATE,NO)};    };    puts "MACRO CoordinateExtractor_SUPPLY_Y ${supplyYFunc}"; ]
