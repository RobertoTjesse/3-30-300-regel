FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_Tester }    INPUT  FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_ExpressionEvaluator_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_isLoop<closeparen>,$(LoopFilter_WORKSPACE_NAME)_Tester)" = 0 ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_Tester_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_Tester_FAILED"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(LoopFilter_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(LoopFilter_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_Tester_PASSED"    OUTPUT { FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,_z1,_z2,_y1,_y2,_isLoop,_x1,_x2)        $($(LoopFilter_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(LoopFilter_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(LoopFilter_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_Tester_FAILED"    OUTPUT { FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,_z1,_z2,_y1,_y2,_isLoop,_x1,_x2)        $($(LoopFilter_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LoopFilter_WORKSPACE_NAME)_PASSED1759838724 Output Collector"   INPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_PASSED"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LoopFilter_WORKSPACE_NAME)_FAILED1759838724 Output Collector"   INPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"   OUTPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_FAILED"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(LoopFilter_WORKSPACE_NAME))}]
