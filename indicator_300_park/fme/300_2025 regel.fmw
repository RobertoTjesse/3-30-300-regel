#! <SUBDOCUMENT
#!   NAME="HorizontalAngleCalculator"
#!   ARCGIS_COMPATIBILITY="ARCGIS_AUTO"
#!   CATEGORY="Calculated Values"
#!   DESCRIPTION="&lt;h2 id=&quot;overview&quot;&gt;Overview&lt;/h2&gt;&#10;&lt;h3 id=&quot;description&quot;&gt;Description&lt;/h3&gt;&#10;&lt;p&gt;This transformer calculates the angle and azimuth of any input line, polyline, or line created by connecting two input points. Angles are measured from the reference point of east (east-0, counter-clockwise positive). The azimuth is the angle between the line and the north vector (north-0, clockwise positive). Output measurement is either degrees, radians, or milliradians (trigonometric).&lt;/p&gt;&#10;&lt;p&gt;&lt;em&gt;Notes&lt;/em&gt;: &lt;/p&gt;&#10;&lt;p&gt;For polylines it returns the angle and azimuth of a line connecting the first and the last vertices of the polyline. For retrieving information about each segment of the polyline use PolylineAnalyzer.&lt;/p&gt;&#10;&lt;p&gt;This transformer replaces the AzimuthCalculator.&lt;/p&gt;&#10;&lt;p&gt;&lt;strong&gt;Keywords:&lt;/strong&gt; Bearing, Heading&lt;/p&gt;"
#!   DOC_DYNAMIC_INPUT_ATTRS="0"
#!   DOC_EXTENTS="10829.2 2253.01"
#!   DOC_TOP_LEFT="-2390.3 -2685.7"
#!   FME_DOCUMENT_GUID="d15563f9-85fa-4373-ace3-f5366883020b"
#!   FME_DOCUMENT_PRIORGUID=""
#!   FME_NAMES_ENCODING="windows-1252"
#!   FME_PROCESS_COUNT="NO_PARALLELISM"
#!   FME_PROCESS_GROUPS_ORDERED="No"
#!   FME_PROCESS_GROUP_BY=""
#!   FME_PROCESS_PRESERVE_GROUP_ATTR="No"
#!   FMX_ATTRIBUTE_PROPOGATION_MODE="AUTO"
#!   GUID="d15563f9-85fa-4373-ace3-f5366883020b"
#!   HISTORY="2017-12-22,Rylan&lt;space&gt;Maschak,Created&lt;space&gt;&lt;openparen&gt;Replaces&lt;space&gt;AzimuthCalculator&lt;closeparen&gt;,2019-01-08,Nathan&lt;space&gt;Hildebrand,Fixed&lt;space&gt;bug&lt;space&gt;in&lt;space&gt;angle&lt;space&gt;calculation.&lt;space&gt;Reformatted&lt;space&gt;description.,2019-07-30,Nathan&lt;space&gt;Hildebrand,Fixed&lt;space&gt;bug&lt;space&gt;introduced&lt;space&gt;in&lt;space&gt;previous&lt;space&gt;edit.&lt;space&gt;Updated&lt;space&gt;description.,2022-10-21,Natalie&lt;space&gt;Clouthier,Fixed&lt;space&gt;measurement&lt;space&gt;errors&lt;space&gt;with&lt;space&gt;Specified&lt;space&gt;mode.&lt;space&gt;Updated&lt;space&gt;description.,2023-08-03,Mark&lt;space&gt;Ireland,Updated&lt;space&gt;to&lt;space&gt;2023.&lt;space&gt;Incremented&lt;space&gt;to&lt;space&gt;v5.&lt;space&gt;Make&lt;space&gt;use&lt;space&gt;of&lt;space&gt;conditional&lt;space&gt;parameters."
#!   IS_VISIBLE="false"
#!   LAST_SAVE_BUILD="FME(R) 2023.0.0.3 (20230613 - Build 23319 - WIN64)"
#!   LAST_SAVE_DATE="2023-08-03T11:26:33"
#!   MARKDOWN_DESCRIPTION="##Overview&#10;&#10;###Description&#10;&#10;This transformer calculates the angle and azimuth of any input line, polyline, or line created by connecting two input points. Angles are measured from the reference point of east (east-0, counter-clockwise positive). The azimuth is the angle between the line and the north vector (north-0, clockwise positive). Output measurement is either degrees, radians, or milliradians (trigonometric).&#10;&#10;*Notes*: &#10;&#10;For polylines it returns the angle and azimuth of a line connecting the first and the last vertices of the polyline. For retrieving information about each segment of the polyline use PolylineAnalyzer.&#10;&#10;&#10;This transformer replaces the AzimuthCalculator.&#10;&#10;**Keywords:** Bearing, Heading"
#!   MARKDOWN_USAGE="###Input Ports&#10;&#10;&#10;Input features must contain valid line geometry, or values specifying two endpoints of a line.&#10;&#10;&#10;###Output Ports&#10;&#10;&#10;Output: Features are output with new attributes containing the angle and azimuth of the line or polyline.&#10;&#10;`_angle`: Angles increase counterclockwise from the reference point of east (which represents zero degrees).&#10;&#10;`_azimuth`: Azimuth values increase clockwise from the reference point of north (which represents zero degrees).&#10;&#10;Rejected: Any features that are not valid line geometry, or are loops (coincident start and end points), will be passed through this port. Rejected features are output with value INVALID_GEOMETRY_TYPE stored in the `fme_rejection_code` attribute.&#10;&#10;&#10;If angles will be calculated from input points, then any features missing all of the x- and y-values are output with value MISSING_PARAMETER_XY_VALUE stored in the `fme_rejection_code`, or, if an attribute value cannot be resolved as a coordinate, then features are output with value INVALID_PARAMETER_XY_VALUE stored in the `fme_rejection_code`.&#10;&#10;###Parameters###&#10;&#10;Calculate Angle from: (Feature, Specified) This parameter will determine whether to calculate the angle and azimuth from the geometry of a feature or set of features (points, lines, polylines), or to calculate from a line created by connecting to input points.&#10;&#10;Point 1 X-Coord: Specify a float or attribute containing a valid x-coordinate.&#10;Point 1 Y-Coord: Specify a float or attribute containing a valid y-coordinate.&#10;Point 2 X-Coord: Specify a float or attribute containing a valid x-coordinate.&#10;Point 2 Y-Coord: Specify a float or attribute containing a valid y-coordinate.&#10;&#10;Angle Unit Measurement: (Degrees, Radians) This parameter sets the unit measurement of the output angle and azimuth.&#10;"
#!   PYTHON_COMPATIBILITY=""
#!   REPLACED_BY=""
#!   SUPPRESS_UPGRADE="false"
#!   TITLE="HorizontalAngleCalculator"
#!   USAGE="&lt;h3 id=&quot;input-ports&quot;&gt;Input Ports&lt;/h3&gt;&#10;&lt;p&gt;Input features must contain valid line geometry, or values specifying two endpoints of a line.&lt;/p&gt;&#10;&lt;h3 id=&quot;output-ports&quot;&gt;Output Ports&lt;/h3&gt;&#10;&lt;p&gt;Output: Features are output with new attributes containing the angle and azimuth of the line or polyline.&lt;/p&gt;&#10;&lt;p&gt;&lt;code&gt;_angle&lt;/code&gt;: Angles increase counterclockwise from the reference point of east (which represents zero degrees).&lt;/p&gt;&#10;&lt;p&gt;&lt;code&gt;_azimuth&lt;/code&gt;: Azimuth values increase clockwise from the reference point of north (which represents zero degrees).&lt;/p&gt;&#10;&lt;p&gt;Rejected: Any features that are not valid line geometry, or are loops (coincident start and end points), will be passed through this port. Rejected features are output with value INVALID_GEOMETRY_TYPE stored in the &lt;code&gt;fme_rejection_code&lt;/code&gt; attribute.&lt;/p&gt;&#10;&lt;p&gt;If angles will be calculated from input points, then any features missing all of the x- and y-values are output with value MISSING_PARAMETER_XY_VALUE stored in the &lt;code&gt;fme_rejection_code&lt;/code&gt;, or, if an attribute value cannot be resolved as a coordinate, then features are output with value INVALID_PARAMETER_XY_VALUE stored in the &lt;code&gt;fme_rejection_code&lt;/code&gt;.&lt;/p&gt;&#10;&lt;h3 id=&quot;parameters&quot;&gt;Parameters&lt;/h3&gt;&#10;&lt;p&gt;Calculate Angle from: (Feature, Specified) This parameter will determine whether to calculate the angle and azimuth from the geometry of a feature or set of features (points, lines, polylines), or to calculate from a line created by connecting to input points.&lt;/p&gt;&#10;&lt;p&gt;Point 1 X-Coord: Specify a float or attribute containing a valid x-coordinate.&#10;Point 1 Y-Coord: Specify a float or attribute containing a valid y-coordinate.&#10;Point 2 X-Coord: Specify a float or attribute containing a valid x-coordinate.&#10;Point 2 Y-Coord: Specify a float or attribute containing a valid y-coordinate.&lt;/p&gt;&#10;&lt;p&gt;Angle Unit Measurement: (Degrees, Radians) This parameter sets the unit measurement of the output angle and azimuth.&lt;/p&gt;"
#!   USE_MARKDOWN="YES"
#!   VIEW_POSITION="-4177.34 484.699"
