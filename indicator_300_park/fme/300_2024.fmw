   if {{OUTGOING} == {OUTGOING}} {      set attrs [list {_angleRad}];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    if {{NO_OP} == {NO_OP}} {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV;    } else {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV_MULTI_FEATURE;    };    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {<at>atan2<openparen><at>Value<openparen>_Y2<closeparen>-<at>Value<openparen>_Y1<closeparen><comma><at>Value<openparen>_X2<closeparen>-<at>Value<openparen>_X1<closeparen><closeparen>};     lappend parmList {FLOAT};    };    lappend parmList {$(HorizontalAngleCalculator_WORKSPACE_NAME)_ExpressionEvaluator_6};    if {{NO_OP} == {OTHER_NULL_VALUE_2}} {     lappend parmList {NO_OP};     lappend parmList {<Unused>};     lappend parmList {0};    };    puts "MACRO __fme_expressionevaluator_evaluateArgs__ [join $parmList ,]";
END_INCLUDE
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_ExpressionEvaluator_6 }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_CoordinateExtractor_2_OUTPUT"    OUTPUT { FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_ExpressionEvaluator_6_OUTPUT"         @EvaluateExpression($(__fme_expressionevaluator_evaluateArgs__))          }
MACRO __fme_expressionevaluator_evaluateArgs__
# -------------------------------------------------------------------------
Tcl2 proc $(HorizontalAngleCalculator_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"_X1 {$($(HorizontalAngleCalculator_WORKSPACE_NAME)_COORD1$encode)} _Y1 {$($(HorizontalAngleCalculator_WORKSPACE_NAME)_COORD1Y$encode)} _X2 {$($(HorizontalAngleCalculator_WORKSPACE_NAME)_COORD2$encode)} _Y2 {$($(HorizontalAngleCalculator_WORKSPACE_NAME)_COORD2Y$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(HorizontalAngleCalculator_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(HorizontalAngleCalculator_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_TestFilter_AngleFrom_AsSpecified"    OUTPUT { FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(HorizontalAngleCalculator_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_hasValue }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"    TEST { _X1 ATTRIBUTE_HAS_A_VALUE "" ENCODED } TEST { _X2 ATTRIBUTE_HAS_A_VALUE "" ENCODED } TEST { _Y1 ATTRIBUTE_HAS_A_VALUE "" ENCODED } TEST { _Y2 ATTRIBUTE_HAS_A_VALUE "" ENCODED }    BOOLEAN_OPERATOR { COMPOSITE }    COMPOSITE_TEST_EXPR { "1 AND 2 AND 3 AND 4" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_hasValue_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_hasValue_FAILED"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_hasValue_PASSED"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_X1<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric)" TYPE NUM ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_X2<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric)" TYPE NUM ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_Y1<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric)" TYPE NUM ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_Y2<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric)" TYPE NUM ENCODED }    BOOLEAN_OPERATOR { COMPOSITE }    COMPOSITE_TEST_EXPR { "1 AND 2 AND 3 AND 4" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric_FAILED"         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric PASSED Splitter"   INPUT FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric_PASSED"   OUTPUT FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric_PASSED_0_xPWGz2kkgMQ="   OUTPUT FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric_PASSED_1_6OSO5IgR/Yo="
# -------------------------------------------------------------------------
FACTORY_DEF {*} VertexCreatorFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point1 }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric_PASSED_0_xPWGz2kkgMQ="    MODE { REPLACE }    INDEX { "<Unused>" }    CONTINUE_ON_ERROR YES    XVAL { "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>_X1<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point1)" }    YVAL { "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>_Y1<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point1)" }    ZVAL { "" }    USE_EXISTING_Z YES    ALLOW_DUPLICATES { "<Unused>" }    CLOSE_LINES { "<Unused>" }    ADD_MODE_VERSION 5    MISSING_VAL_MODE { <Unused> }    COMPUTE_MEASURES_MODE { CONTINUOUS }    COMMAND_PARM_EVALUATION SINGLE_PASS    OUTPUT { OUTPUT FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point1_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} VertexCreatorFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point2 }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Tester_Numeric_PASSED_1_6OSO5IgR/Yo="    MODE { REPLACE }    INDEX { "<Unused>" }    CONTINUE_ON_ERROR YES    XVAL { "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>_X2<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point2)" }    YVAL { "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>_Y2<closeparen>,$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point2)" }    ZVAL { "" }    USE_EXISTING_Z YES    ALLOW_DUPLICATES { "<Unused>" }    CLOSE_LINES { "<Unused>" }    ADD_MODE_VERSION 5    MISSING_VAL_MODE { <Unused> }    COMPUTE_MEASURES_MODE { CONTINUOUS }    COMMAND_PARM_EVALUATION SINGLE_PASS    OUTPUT { OUTPUT FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point2_OUTPUT"        }
# -------------------------------------------------------------------------
# This is just a simple delay, which is given a # of seconds to stall
Tcl2 proc $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_delay {seconds unused} {     after [expr round($seconds * 1000)]; }
Tcl2 set $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy [clock clicks -milliseconds];
# This proc ensures that no more than some maximum number of features get through each second
Tcl2 proc $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_maxpersecond {unused maxFeaturesPerSecond} {     global $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy;     set minimumDelayInMilliseconds [expr 1000.0 / $maxFeaturesPerSecond];     set clockMillisecondsNow [clock clicks -milliseconds];     set milliSecondsSinceLastFeature [expr $clockMillisecondsNow -                    [set $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy]];     if {$milliSecondsSinceLastFeature < $minimumDelayInMilliseconds} {         after [expr round($minimumDelayInMilliseconds - $milliSecondsSinceLastFeature)];     };     set $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy [clock clicks -milliseconds]; }
# Now set up which of the above two delay procedures we'll actually
# use by renaming the one we want to "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter"
# Then that is what we'll actually call when a feature goes by.
Tcl2 if { {Per Feature Delay} == {Per Feature Delay} } {         rename $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_delay $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter;      } else {         rename $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_maxpersecond $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter;      };
# If we're in Per Feature Delay mode, AND the Per Feature Delay is 0, let's very efficiently split
# any feature table into individual features. If an individual feature would go in, this is a no op
INCLUDE [    if { ( {Per Feature Delay} == {Per Feature Delay} ) && ( {0.5} == {0} ) } {       puts "MACRO SPLIT_FEATURE_TABLE *";       puts "MACRO NORMAL_DECELERATION _NO_";    } else {       puts "MACRO SPLIT_FEATURE_TABLE _NO_";       puts "MACRO NORMAL_DECELERATION *";    } ]
FACTORY_DEF {$(SPLIT_FEATURE_TABLE)} FeatureTableSplitterFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point2_OUTPUT"    OUTPUT { FEATURES FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_OUTPUT"          }
# Above for feature table splitting case (when per feature delay is 0, below for everything else
FACTORY_DEF {$(NORMAL_DECELERATION)} TestFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_DelayRejector }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point2_OUTPUT"    TEST { "0.5" TYPE NUM ENCODED }    TEST { PERFEATDELAY != PERFEATDELAY }    BOOLEAN_OPERATOR OR    OUTPUT { FAILED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_<REJECTED>"       fme_rejection_code "INVALID_PARAMETER_DELAY_PER_FEATURE"        }    OUTPUT { PASSED FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toMaximumRejector__ }
FACTORY_DEF {$(NORMAL_DECELERATION)} TestFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_MaximumRejector }    INPUT { FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toMaximumRejector__ }    TEST { "<Unused>" TYPE NUM ENCODED }    TEST { PERFEATDELAY != FEATPERSEC }    BOOLEAN_OPERATOR OR    OUTPUT { FAILED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_<REJECTED>"       fme_rejection_code "INVALID_PARAMETER_MAXIMUM_FEATURES_PER_SECOND"        }    OUTPUT { PASSED FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toOutput__ }
FACTORY_DEF {$(NORMAL_DECELERATION)} TeeFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Decelerator }    INPUT { FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toOutput__ }    OUTPUT { FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_OUTPUT"         @Tcl2("$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter {0.5} {<Unused>}")          }
