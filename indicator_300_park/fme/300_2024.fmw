MACRO FeatureReader_5_OUTPUT_PORTS_ENCODED groen_uit_osm_top10_2024
MACRO FeatureReader_5_DIRECTIVES ALIAS_MODE,NONE,BEGIN_SQL{0},,CACHE_MULTIPATCH_TEXTURES,yes,CHECK_SIMPLE_GEOM,no,CREATE_FEATURE_TABLES_FROM_DATA,Yes,DISABLE_FEATURE_DATASET_ATTRIBUTE,Yes,END_SQL{0},,EXPOSE_ATTRS_GROUP,,FEATURE_READ_MODE,Features,GEODATABASE_FILE_EXPOSE_FORMAT_ATTRS,,GEODB_SHARED_RDR_ADV_PARM_GROUP,,GEOMETRY,,IGNORE_NETWORK_INFO,yes,IGNORE_RELATIONSHIP_INFO,yes,MERGE_FEAT_LINKED_ANNOS,no,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,READ_THREE_POINT_ARCS,no,REMOVE_FEATURE_DATASET,NO,RESOLVE_DOMAINS,no,RESOLVE_SUBTYPE_NAMES,yes,SIMPLE_DONUT_GEOMETRY,no,SPLIT_COMPLEX_ANNOS,no,SPLIT_COMPLEX_EDGES,no,SPLIT_MULTI_PART_ANNOS,no,STRIP_GUID_GLOBALID_BRACES,no,TABLELIST,,TRANSLATE_SPATIAL_DATA_ONLY,no,USE_SEARCH_ENVELOPE,NO,WHERE_WWJD,
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {NONE} == {<Unused>} ) || ( {($INTERACT)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "NONE"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO FeatureReader_5_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO FeatureReader_5_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO FeatureReader_5_COMBINE_ATTRS RESULT_ONLY";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_FeatureReader_5 @EvaluateExpression(FDIV,STRING_ENCODED,$(FME_MF_DIR_ENCODED)fme<space>input<backslash>Groenvoorzierningen<backslash>groenkaart.gdb,FeatureReader_5)}; ]
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { FeatureReader_5 }    INPUT  FEATURE_TYPE Creator_2_CREATED_0_RREa/RGmstk=    $(FCTQUERY_INTERACTION_LINE)    QUERY_WHERE         { "<quote>bron<quote><space><lt><gt><space><apos>top<space>10<space>water<apos>" }    COMBINE_ATTRIBUTES  { $(FeatureReader_5_COMBINE_ATTRS) }    IGNORE_NULLS        { <Unused> }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { RESULT_ONLY }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { GEODATABASE_FILE  }    READER_DATASET      { "$(FeatureReaderDataset_FeatureReader_5)" }    QUERYFCT_IDS        { "groen_uit_osm_top10_2024" }    QUERYFCT_IDS_FORMAT WWJD_PARTS    READER_DIRECTIVES   { METAFILE,GEODATABASE_FILE }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    QUERYFCT_ADD_SCHEMA { "NO" }    QUERYFCT_DEDUPE_GEOM YES    CONTINUE_ON_READER_ERROR YES    ORDER_RESULTS { "No" }    QUERYFCT_RESULT_TAGS { $(FeatureReader_5_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    READER_PARAMS_WWJD     { $(FeatureReader_5_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    OUTPUT groen_uit_osm_top10_2024 FEATURE_TYPE FeatureReader_5_groen_uit_osm_top10_2024
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Reprojector_5 }    INPUT  FEATURE_TYPE FeatureReader_5_groen_uit_osm_top10_2024    OUTPUT { FEATURE_TYPE Reprojector_5_REPROJECTED         @Reproject("","Amersfoort-RDNew",NearestNeighbor,PreserveCells,Reprojector_5,"COORD_SYS_WARNING",RASTER_TOLERANCE,"0.0")          }
# -------------------------------------------------------------------------
