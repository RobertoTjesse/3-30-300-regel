#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI LOOKUP_CHOICE_OR_ATTR UNIT_OUTPUT Degrees,DEG%Radians,RAD Angle Unit Measurement"
#!   DEFAULT_VALUE="DEG"
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI CHOICE_OR_ATTR ANGLE_TYPE Feature%Specified Calculate Angle from"
#!   DEFAULT_VALUE="Feature"
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI OPTIONAL NAMEDGROUP SpecifiedBox COORD1%COORD1Y%COORD2%COORD2Y Specified Coordinates"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI FLOAT_OR_ATTR COORD1 Point 1 X-Coord"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI FLOAT_OR_ATTR COORD1Y Point 1 Y-Coord"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI FLOAT_OR_ATTR COORD2 Point 2 X-Coord"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI FLOAT_OR_ATTR COORD2Y Point 2 Y-Coord"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! </GLOBAL_PARAMETERS>
#! <USER_PARAMETERS
#!   FORM=""
#! >
#! <PARAMETER_INFO>
#!     <INFO NAME="GeneralBox" 
#!   DEFAULT_VALUE=""
#!   SCOPE="STAND_ALONE"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI OPTIONAL NAMEDGROUP GeneralBox UNIT_OUTPUT%ANGLE_TYPE General"
#! />
#!     <INFO NAME="UNIT_OUTPUT" 
