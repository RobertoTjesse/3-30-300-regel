# 20210313 - Use Macros to engage/disengage the solid vs. 2d buffering rather than a runtime
# check to reduce processing overhead
INCLUDE [if { ("JOIN_ARC" == "JOIN_MITER") } {         } else {             puts "MACRO MITER_TO_USE 0"         };         if { ("AREA" == "SOLID") } {             puts "MACRO SOLIDFACTORYENGAGED *";             puts "MACRO DISSOLVEFACTORYENGAGED NO";         } else {             puts "MACRO SOLIDFACTORYENGAGED NO";             puts "MACRO DISSOLVEFACTORYENGAGED *";         };         ]
#
# This is the AREA part of the buffering:
#
FACTORY_DEF {$(DISSOLVEFACTORYENGAGED)} PolygonDissolveFactory    FACTORY_NAME { $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_Bufferer_2DBuffering }    INPUT  FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_TestFilter_has<space>intersection_0_eQT7yTkPF+0="    FLUSH_WHEN_GROUPS_CHANGE { No }    REJECT_INVALID_GEOM Yes    USE_AZMED_NEIGHBORHOOD Yes    PRE_BUFFER { "0.1" "22.5" "CAP_ARC" "JOIN_ARC" "$(MITER_TO_USE)" FULL OFFSET_UNITS "NONE" PRECISION "APPROX" }    DISSOLVE_MODE GEOS    CLEANING_TOLERANCE { AUTO }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    OUTPUT { POLYGON FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_Bufferer_BUFFERED"         }    OUTPUT { NON_POLYGON FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_Bufferer_BUFFERED"         }    OUTPUT { REJECTED FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_Bufferer_<REJECTED>"         }
#
