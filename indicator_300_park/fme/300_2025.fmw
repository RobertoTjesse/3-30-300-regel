MACRO $(LoopFilter_WORKSPACE_NAME)_SUB_DOC_NAME LoopFilter
DEFAULT_MACRO LoopFilter_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(LoopFilter_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(LoopFilter_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LoopFilter_WORKSPACE_NAME)_LINE1750063100 Input Splitter"   INPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LINE"   OUTPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LINE"
# -------------------------------------------------------------------------
MACRO OUTPUT_LINE_FTYPE not_selected
MACRO OUTPUT_LINE_FTYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter_LINE
MACRO OUTPUT_INSTANCE_FTYPE not_selected
Lookup $(LoopFilter_WORKSPACE_NAME)_LineFilter_RouterTable   ""  "not_selected"   fme_line $(OUTPUT_LINE_FTYPE)
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(LoopFilter_WORKSPACE_NAME)_LineFilter_ac6489f4_1dc9_432f_b1a7_28aa1e8d26720} ]
MACRO COLLECTION_HANDLING NOT_THIS_TIME
MACRO INSTANCE_FILTERING *
INCLUDE [    if 0 {       puts "MACRO COLLECTION_HANDLING *";       if <Unused> {          puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";       };    };    if {{$(OUTPUT_INSTANCE_FTYPE)} == "not_selected"} {       puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_InputPassThrough }    INPUT  FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LINE"    OUTPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___       @Geometry(FIX_FMETYPE_FMEGEOMETRY) }
FACTORY_DEF {$(INSTANCE_FILTERING)} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_InstanceTest }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }    TEST @Geometry(IS_GEOMETRY_INSTANCE) == 1    OUTPUT { PASSED FEATURE_TYPE $(OUTPUT_INSTANCE_FTYPE) }    OUTPUT { FAILED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }
FACTORY_DEF {$(COLLECTION_HANDLING)} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_CollectionTest }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }    TEST &fme_type == "fme_collection"    OUTPUT { FAILED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Not_Collection___ }    OUTPUT { PASSED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Collection___ }
FACTORY_DEF {$(COLLECTION_HANDLING)} DeaggregateFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_Deagg }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Collection___ }    HOMOGENIZE_COLLECTIONS YES    RECURSIVE YES    SET_FME_TYPE YES    INSTANTIATE_GEOMETRY_INSTANCES_NEW { <Unused> }    OUTPUT { POINT FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { LINE FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { POLYGON FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { DONUT FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { AGGREGATE FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_RouterPrepper }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Not_Collection___ }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }    OUTPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Prepped___        @Lookup($(LoopFilter_WORKSPACE_NAME)_LineFilter_RouterTable,fme_type,ENCODED_ATTR,$(FME_UUID_SAFE)_targetFeatureType) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_Router }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Prepped___ }    TEST { @Value($(FME_UUID_SAFE)_targetFeatureType) != "not_selected" }    OUTPUT { PASSED FEATURE_TYPE * @FeatureType(@Value($(FME_UUID_SAFE)_targetFeatureType))                                 @RemoveAttributes($(FME_UUID_SAFE)_targetFeatureType) }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LineFilter_<UNFILTERED>"        @RemoveAttributes($(FME_UUID_SAFE)_targetFeatureType)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LoopFilter_WORKSPACE_NAME)_LineFilter <UNFILTERED> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LineFilter_<UNFILTERED>"
# -------------------------------------------------------------------------
INCLUDE [    set supplyXFunc {};    if { {_x1} != {} }    {       set supplyXFunc {@Coordinate(REJECTABLE,x,"0",FLATTEN_AGGREGATE,YES)};    };    puts "MACRO $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_X ${supplyXFunc}"; ]
INCLUDE [    set supplyYFunc {};    if { {_y1} != {} }    {       set supplyYFunc {@Coordinate(REJECTABLE,y,"0",FLATTEN_AGGREGATE,NO)};    };    puts "MACRO $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Y ${supplyYFunc}"; ]
INCLUDE [    set supplyZDefaultFunc {};    if { {} != {} }    {       set supplyZDefaultFunc {@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING,"_z1",,FLOAT)};    };    puts "MACRO $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Z_DEFAULT ${supplyZDefaultFunc}"; ]
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_TESTZDEFAULT }    INPUT  FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LineFilter_LINE"    TEST { "" = "" ENCODED }    TEST { "" TYPE NUM ENCODED }    BOOLEAN_OPERATOR OR    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { PASSED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_TESTMODE_INPUT }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"       @SupplyAttributes(fme_rejection_code, INVALID_PARAMETER_DEFAULT_Z)        }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_TESTMODE }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_TESTMODE_INPUT }    TEST { "Specify Coordinate" == "All Coordinates" }    OUTPUT { PASSED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_LIST_INPUT }    OUTPUT { FAILED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_INPUT }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_LIST }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_LIST_INPUT }    TEST @Dimension() == 2    OUTPUT { PASSED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"         @ZValue("")         @Coordinate(x,ALL,"<Unused>"{}.x,FLATTEN_AGGREGATE,YES)         @Coordinate(y,ALL,"<Unused>"{}.y,FLATTEN_AGGREGATE,NO)         @Coordinate(z,ALL,"<Unused>"{}.z,FLATTEN_AGGREGATE,NO)         @Dimension(2)          }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"         @Coordinate(x,ALL,"<Unused>"{}.x,FLATTEN_AGGREGATE,YES)         @Coordinate(y,ALL,"<Unused>"{}.y,FLATTEN_AGGREGATE,NO)         @Coordinate(z,ALL,"<Unused>"{}.z,FLATTEN_AGGREGATE,NO)          }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_INPUT }    TEST { "0" TYPE INT ENCODED }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { PASSED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_X_INPUT }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"       @SupplyAttributes(fme_rejection_code, INVALID_PARAMETER_INDEX)        }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_X }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_X_INPUT }    FUNCTION_DEFINITION { $($(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_X) }    RESULT_ATTRIBUTE { "_x1" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y_INPUT }    OUTPUT { REJECTED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y_INPUT }    FUNCTION_DEFINITION { $($(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Y) }    RESULT_ATTRIBUTE { "_y1" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER_INPUT }    OUTPUT { REJECTED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER_INPUT }    TEST { "_z1" != "" ENCODED }    TEST @Dimension() == 3    BOOLEAN_OPERATOR AND    OUTPUT { PASSED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_INPUT }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"       $($(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Z_DEFAULT)        }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_INPUT }    FUNCTION_DEFINITION { @Coordinate(REJECTABLE,z,"0",FLATTEN_AGGREGATE,NO) }    RESULT_ATTRIBUTE { "_z1" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
