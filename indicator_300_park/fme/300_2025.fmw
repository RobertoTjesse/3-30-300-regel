# -------------------------------------------------------------------------
# This is just a simple delay, which is given a # of seconds to stall
Tcl2 proc $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_delay {seconds unused} {     after [expr round($seconds * 1000)]; }
Tcl2 set $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy [clock clicks -milliseconds];
# This proc ensures that no more than some maximum number of features get through each second
Tcl2 proc $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_maxpersecond {unused maxFeaturesPerSecond} {     global $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy;     set minimumDelayInMilliseconds [expr 1000.0 / $maxFeaturesPerSecond];     set clockMillisecondsNow [clock clicks -milliseconds];     set milliSecondsSinceLastFeature [expr $clockMillisecondsNow -                    [set $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy]];     if {$milliSecondsSinceLastFeature < $minimumDelayInMilliseconds} {         after [expr round($minimumDelayInMilliseconds - $milliSecondsSinceLastFeature)];     };     set $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_clockMillisecondsWhenLastFeatureWentBy [clock clicks -milliseconds]; }
# Now set up which of the above two delay procedures we'll actually
# use by renaming the one we want to "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter"
# Then that is what we'll actually call when a feature goes by.
Tcl2 if { {Per Feature Delay} == {Per Feature Delay} } {         rename $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_delay $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter;      } else {         rename $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_maxpersecond $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter;      };
INCLUDE [    if { ( {Per Feature Delay} == {Per Feature Delay} ) && ( {0.5} == {0} ) } {       puts {MACRO $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_SPLITTER_OUTPUT "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_OUTPUT" };    } else {       puts {MACRO $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_SPLITTER_OUTPUT $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toDelayRejector__};    } ]
FACTORY_DEF {*} FeatureTableSplitterFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator }    INPUT  FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_VertexCreator_Point2_OUTPUT"    OUTPUT { FEATURES FEATURE_TYPE $($(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_SPLITTER_OUTPUT) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_DelayRejector }    INPUT { FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toDelayRejector__ }    TEST { "0.5" TYPE NUM ENCODED }    TEST { PERFEATDELAY != PERFEATDELAY }    BOOLEAN_OPERATOR OR    OUTPUT { FAILED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_<REJECTED>"       fme_rejection_code "INVALID_PARAMETER_DELAY_PER_FEATURE"        }    OUTPUT { PASSED FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toMaximumRejector__ }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_MaximumRejector }    INPUT { FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toMaximumRejector__ }    TEST { "<Unused>" TYPE NUM ENCODED }    TEST { PERFEATDELAY != FEATPERSEC }    BOOLEAN_OPERATOR OR    OUTPUT { FAILED FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_<REJECTED>"       fme_rejection_code "INVALID_PARAMETER_MAXIMUM_FEATURES_PER_SECOND"        }    OUTPUT { PASSED FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toOutput__ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Decelerator }    INPUT { FEATURE_TYPE $(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator__toOutput__ }    OUTPUT { FEATURE_TYPE "$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_OUTPUT"         @Tcl2("$(HorizontalAngleCalculator_WORKSPACE_NAME)_Decelerator_Waiter {0.5} {<Unused>}")          }
