FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y_INPUT }    FUNCTION_DEFINITION { $($(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Y) }    RESULT_ATTRIBUTE { "_y1" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER_INPUT }    OUTPUT { REJECTED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER_INPUT }    TEST { "_z1" != "" ENCODED }    TEST @Dimension() == 3    BOOLEAN_OPERATOR AND    OUTPUT { PASSED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_INPUT }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"       $($(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Z_DEFAULT)        }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_INPUT }    FUNCTION_DEFINITION { @Coordinate(REJECTABLE,z,"0",FLATTEN_AGGREGATE,NO) }    RESULT_ATTRIBUTE { "_z1" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
