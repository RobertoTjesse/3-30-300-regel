Lookup $(LoopFilter_WORKSPACE_NAME)_LineFilter_RouterTable   ""  "not_selected"   fme_line $(OUTPUT_LINE_FTYPE)
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(LoopFilter_WORKSPACE_NAME)_LineFilter_87822bd6_2f74_4ab6_9ae7_4681ce7c58ad22} ]
MACRO COLLECTION_HANDLING NOT_THIS_TIME
MACRO INSTANCE_FILTERING *
INCLUDE [    if 0 {       puts "MACRO COLLECTION_HANDLING *";       if <Unused> {          puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";       };    };    if {{$(OUTPUT_INSTANCE_FTYPE)} == "not_selected"} {       puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_InputPassThrough }    INPUT  FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LINE"    OUTPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___       @Geometry(FIX_FMETYPE_FMEGEOMETRY) }
FACTORY_DEF {$(INSTANCE_FILTERING)} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_InstanceTest }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }    TEST @Geometry(IS_GEOMETRY_INSTANCE) == 1    OUTPUT { PASSED FEATURE_TYPE $(OUTPUT_INSTANCE_FTYPE) }    OUTPUT { FAILED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }
FACTORY_DEF {$(COLLECTION_HANDLING)} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_CollectionTest }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }    TEST &fme_type == "fme_collection"    OUTPUT { FAILED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Not_Collection___ }    OUTPUT { PASSED FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Collection___ }
FACTORY_DEF {$(COLLECTION_HANDLING)} DeaggregateFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_Deagg }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Collection___ }    HOMOGENIZE_COLLECTIONS YES    RECURSIVE YES    SET_FME_TYPE YES    INSTANTIATE_GEOMETRY_INSTANCES_NEW { <Unused> }    OUTPUT { POINT FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { LINE FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { POLYGON FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { DONUT FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    OUTPUT { AGGREGATE FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_RouterPrepper }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___HomogeneousAggregate___ }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Not_Collection___ }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Input___ }    OUTPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Prepped___        @Lookup($(LoopFilter_WORKSPACE_NAME)_LineFilter_RouterTable,fme_type,ENCODED_ATTR,$(FME_UUID_SAFE)_targetFeatureType) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_LineFilter_Router }    INPUT { FEATURE_TYPE $(LoopFilter_WORKSPACE_NAME)_LineFilter___Prepped___ }    TEST { @Value($(FME_UUID_SAFE)_targetFeatureType) != "not_selected" }    OUTPUT { PASSED FEATURE_TYPE * @FeatureType(@Value($(FME_UUID_SAFE)_targetFeatureType))                                 @RemoveAttributes($(FME_UUID_SAFE)_targetFeatureType) }    OUTPUT { FAILED FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LineFilter_<UNFILTERED>"        @RemoveAttributes($(FME_UUID_SAFE)_targetFeatureType)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LoopFilter_WORKSPACE_NAME)_LineFilter <UNFILTERED> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_LineFilter_<UNFILTERED>"
# -------------------------------------------------------------------------
INCLUDE [    set supplyXFunc {};    if { {_x1} != {} }    {       set supplyXFunc {@Coordinate(REJECTABLE,x,"0",FLATTEN_AGGREGATE,YES)};    };    puts "MACRO $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_X ${supplyXFunc}"; ]
INCLUDE [    set supplyYFunc {};    if { {_y1} != {} }    {       set supplyYFunc {@Coordinate(REJECTABLE,y,"0",FLATTEN_AGGREGATE,NO)};    };    puts "MACRO $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Y ${supplyYFunc}"; ]
INCLUDE [    set supplyZDefaultFunc {};    if { {} != {} }    {       set supplyZDefaultFunc {@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING,"_z1",,FLOAT)};    };    puts "MACRO $(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Z_DEFAULT ${supplyZDefaultFunc}"; ]
