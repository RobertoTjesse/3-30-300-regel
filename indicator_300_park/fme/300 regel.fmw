INCLUDE TCL
   if {{OUTGOING} == {OUTGOING}} {      set attrs [list {_isLoop}];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    if {{NO_OP} == {NO_OP}} {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV;    } else {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV_MULTI_FEATURE;    };    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {<openparen><at>Value<openparen>_x1<closeparen>-<at>Value<openparen>_x2<closeparen><closeparen><pipe><pipe><openparen><at>Value<openparen>_y1<closeparen>-<at>Value<openparen>_y2<closeparen><closeparen>};     lappend parmList {FLOAT};    };    lappend parmList {$(LoopFilter_WORKSPACE_NAME)_ExpressionEvaluator};    if {{NO_OP} == {OTHER_NULL_VALUE_2}} {     lappend parmList {NO_OP};     lappend parmList {<Unused>};     lappend parmList {0};    };    puts "MACRO __fme_expressionevaluator_evaluateArgs__ [join $parmList ,]";
END_INCLUDE
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LoopFilter_WORKSPACE_NAME)_ExpressionEvaluator }    INPUT  FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_CoordinateExtractor_2_OUTPUT"    OUTPUT { FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_ExpressionEvaluator_OUTPUT"         @EvaluateExpression($(__fme_expressionevaluator_evaluateArgs__))          }
MACRO __fme_expressionevaluator_evaluateArgs__
