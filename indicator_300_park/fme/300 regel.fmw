FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LoopFilter_WORKSPACE_NAME)_FAILED1751539678 Output Collector"   INPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"   OUTPUT FEATURE_TYPE "$(LoopFilter_WORKSPACE_NAME)_FAILED"
