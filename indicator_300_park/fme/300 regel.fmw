FACTORY_DEF {*} PythonFactory    FACTORY_NAME { $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_PythonCaller }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT  FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_PointOnLineOverlayer_POINT"    SYMBOL_NAME { FeatureProcessor }    SOURCE_CODE { import<space>fme<lf>import<space>fmeobjects<lf><lf><lf>class<space>FeatureProcessor<openparen>object<closeparen>:<lf><space><space><space><space><quote><quote><quote>Template<space>Class<space>Interface:<lf><space><space><space><space>When<space>using<space>this<space>class<comma><space>make<space>sure<space>its<space>name<space>is<space>set<space>as<space>the<space>value<space>of<space>the<space><apos>Class<lf><space><space><space><space>to<space>Process<space>Features<apos><space>transformer<space>parameter.<lf><space><space><space><space><quote><quote><quote><lf><lf><space><space><space><space>def<space>__init__<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space><quote><quote><quote>Base<space>constructor<space>for<space>class<space>members.<quote><quote><quote><lf><space><space><space><space><space><space><space><space>pass<lf><lf><space><space><space><space>def<space>input<openparen>self<comma><space>feature<closeparen>:<lf><space><space><space><space><space><space><space><space>angle_delta<space>=<space>feature.getAttribute<openparen><apos>angles<opencurly>1<closecurly>._angle<apos><closeparen>-feature.getAttribute<openparen><apos>angles<opencurly>0<closecurly>._angle<apos><closeparen><lf><space><space><space><space><space><space><space><space>converted_angle<space>=<space>self.convert_to_0_to_90<openparen>angle_delta<closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>angle_delta<apos><comma>converted_angle<closeparen><lf><space><space><space><space><space><space><space><space>self.pyoutput<openparen>feature<closeparen><lf><space><space><space><space><space><space><space><space><lf><space><space><space><space>def<space>convert_to_0_to_90<openparen>self<comma>angle<closeparen>:<lf><space><space><space><space><space><space><space><space>#<space>Normalize<space>the<space>angle<space>to<space>be<space>within<space>the<space>range<space>-360<space>to<space>360<lf><space><space><space><space><space><space><space><space>normalized_angle<space>=<space>angle<space>%<space>360<lf><lf><space><space><space><space><space><space><space><space>#<space>Ensure<space>the<space>angle<space>is<space>positive<lf><space><space><space><space><space><space><space><space>if<space>normalized_angle<space><lt><space>0:<lf><space><space><space><space><space><space><space><space><space><space><space><space>normalized_angle<space>+=<space>360<lf><lf><space><space><space><space><space><space><space><space>#<space>Convert<space>the<space>angle<space>to<space>the<space>range<space>0<space>to<space>90<lf><space><space><space><space><space><space><space><space>if<space>normalized_angle<space><lt>=<space>90:<lf><space><space><space><space><space><space><space><space><space><space><space><space>return<space>normalized_angle<lf><space><space><space><space><space><space><space><space>elif<space>normalized_angle<space><lt>=<space>180:<lf><space><space><space><space><space><space><space><space><space><space><space><space>return<space>180<space>-<space>normalized_angle<lf><space><space><space><space><space><space><space><space>elif<space>normalized_angle<space><lt>=<space>270:<lf><space><space><space><space><space><space><space><space><space><space><space><space>return<space>normalized_angle<space>-<space>180<lf><space><space><space><space><space><space><space><space>else:<lf><space><space><space><space><space><space><space><space><space><space><space><space>return<space>360<space>-<space>normalized_angle }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_PythonCaller_OUTPUT"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "angles<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_PythonCaller_OUTPUT"    OUTPUT { FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,Id_requestor,Id_supplier,_overlaps)        $($(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
Tcl2 proc $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder_round {places} {    set attrNames [split {angle_delta} { }];    set funcName {round};    set parmList {{EvaluateExpression} {ATTR_SET_EXPR}};    set hasAttr 0;    foreach attrName $attrNames {       set decodedAttrName [FME_DecodeText $attrName];       set attrValue [FME_GetAttribute $decodedAttrName];       set comment {"--- skip null or missing attribute names without warning ---"};       if {$attrValue == {} || [FME_IsAttributeNull $decodedAttrName]} {          continue;       };       set comment {"--- do not round if the value is a string. warn skip the attribute ---"};       if {[string is double $attrValue] == 0} {          FME_LogMessage fme_warn 917360 {$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder} $decodedAttrName $attrValue;          continue;       };       set hasAttr 1;       set funcAttr $attrName;       set comment {"--- handle WWJD encoded attribute name embedded quote escaping ---"};       if { [string first "<quote>" $attrName] != -1 }       {          set funcAttr [string map {"<quote>" "<backslash><quote>"} $attrName];          append funcAttr "<quote>";          set funcAttr "<quote>"$funcAttr;       };       set comment {"--- build a WWJD string of: @round|ceil|floor(@Value(attrName),places) ---"};       set funcCall [join [list "<at>" $funcName "<openparen><at>Value<openparen>" $funcAttr "<closeparen><comma>" $places "<closeparen>"] {}];       lappend parmList $attrName;       lappend parmList $funcCall;    };    if {$hasAttr > 0} {       lappend parmList {$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder};       eval FME_Execute $parmList;    }; }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder }    INPUT  FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"    TEST { "@EvaluateExpression(FDIV,FLOAT,$($(LineOnLineIntersectionAngle_WORKSPACE_NAME)_DECIMAL_PLACES$encode),$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder)" TYPE INT ENCODED }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { FAILED FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder_<REJECTED>"       fme_rejection_code "INVALID_PARAMETER_DECIMAL_PLACES"        }    OUTPUT { PASSED FEATURE_TYPE __toOutput__ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder_AttributeRounder }    INPUT FEATURE_TYPE __toOutput__    OUTPUT { FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder_OUTPUT"         @Tcl2("$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder_round {@EvaluateExpression(FDIV,FLOAT,$($(LineOnLineIntersectionAngle_WORKSPACE_NAME)_DECIMAL_PLACES$encode),$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder)}")          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder_<Rejected>" INPUT FEATURE_TYPE "$(LineOnLineIntersectionAngle_WORKSPACE_NAME)_AttributeRounder_<REJECTED>"  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, LineOnLineIntersectionAngle_AttributeRounder<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
