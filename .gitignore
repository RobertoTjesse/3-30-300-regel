# Data — large geospatial artefacts, never committed.
# The real source data lives on the network share (config.VIEWANALYSE_DIR);
# these local folders only ever hold generated/scratch files.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/dem_tiles/
!data/interim/viewshed_tiles/
data/interim/dem_tiles/*
!data/interim/dem_tiles/.gitkeep
data/interim/viewshed_tiles/*
!data/interim/viewshed_tiles/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# One-off SDE re-export staging — large rasters, never committed. Keep the
# script and extent metadata (tracked), not the multi-GB clipped outputs.
indicator_3_bomen/sde_reexport/raw_clips/
indicator_3_bomen/sde_reexport/finished/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Machine-specific settings (real paths, never shared) — see config_local.example.py
indicator_3_bomen/etl/config_local.py

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# QGIS validation project — generated by qgis_validation/build_project.py
qgis_validation/*.qgz
qgis_validation/*.qgz~
qgis_validation/*.qgd

# Experiments (ArcGIS comparisons, one-tree and study-area tests, NEO export):
# scripts and outputs stay local, never on GitHub
indicator_3_bomen/arcgis_tests/

# Web map data — built by web/build_tiles.py, published on the gh-pages branch only
web/data/

# Study area runs (arcgis_tests/studiegebied.py prepare regenerates them)
data/studiegebied/
# Copies of the FME results and inputs for the 30 and 300 (from R:)
data/fme_output/
data/fme_input/

