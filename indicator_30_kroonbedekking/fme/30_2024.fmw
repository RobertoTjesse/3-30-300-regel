MACRO SQLExecutor_DIRECTIVES APPLICATION_INTENT ReadWrite COMMAND_TIMEOUT 200 CREATE_FEATURE_TABLES_FROM_DATA Yes NAMED_CONNECTION sql_geo QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS Yes
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { SQLExecutor }    INPUT  FEATURE_TYPE FeatureReader_6_wijken_0_6VPbVlm530g=    QUERY_SQL            { "@EvaluateExpression(FDIV,STRING_ENCODED,WITH<space>wijk_geom<space>AS<space><openparen><lf><space><space>SELECT<space><lf><space><space><space><space>wijkcode<comma><space><lf><space><space><space><space>SHAPE<space>AS<space>wijk_shape<lf><space><space>FROM<space>GRENZEN.CBS_WIJKKAART_2022_VERSIE3<lf><space><space>WHERE<space>wijkcode<space>=<space><apos><at>Value<openparen>wijkcode<closeparen><apos><lf><closeparen><comma><lf><lf>bomen_in_wijk<space>AS<space><openparen><lf><space><space>SELECT<space><lf><space><space><space><space>b.CROWN_AREA<lf><space><space>FROM<space>BODEM.BOMEN_KRONEN<space>b<lf><space><space>JOIN<space>wijk_geom<space>w<space><lf><space><space><space><space>ON<space>b.SHAPE.STIntersects<openparen>w.wijk_shape<closeparen><space>=<space>1<lf><closeparen><lf><lf>SELECT<space><lf><space><space><apos><at>Value<openparen>wijkcode<closeparen><apos><space>AS<space>wijkcode<comma><lf><space><space>SUM<openparen>CROWN_AREA<closeparen><space>AS<space>totaal_kroonoppervlak_m2<lf>FROM<space>bomen_in_wijk<semicolon><lf>,SQLExecutor)" }    READER_TYPE          { MSSQL_SPATIAL }    READER_DATASET       { "sql_geo" }    COMBINE_ATTRIBUTES   { RESULT_ONLY }    IGNORE_NULLS         { <Unused> }    COMBINE_GEOMETRY     { RESULT_ONLY }    QUERYFCT_OUTPUT      { "DATA_ONLY" }    CONTINUE_ON_READER_ERROR YES    QUERYFCT_PROPAGATE_IDS_ON_SQL_EXECUTE YES    READER_PARAMS        { $(SQLExecutor_DIRECTIVES) }    OUTPUT { RESULT FEATURE_TYPE SQLExecutor_RESULT        @SupplyAttributes(fme_feature_type,SQLExecutor)         }    OUTPUT { READER_ERROR FEATURE_TYPE SQLExecutor_<REJECTED>         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeExposer }    INPUT  FEATURE_TYPE SQLExecutor_RESULT    OUTPUT { FEATURE_TYPE AttributeExposer_OUTPUT          }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {Logger_c758739f_38bb_42d2_af96_429468b90a530} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME Logger
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Logger_Logger }    INPUT  FEATURE_TYPE SQLExecutor_<REJECTED>    OUTPUT { FEATURE_TYPE Logger_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Feature is:","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Logger LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE Logger_LOGGED
# -------------------------------------------------------------------------
FACTORY_DEF {*} FeatureJoinerFactory    FACTORY_NAME { FeatureJoiner }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT LEFT FEATURE_TYPE FeatureReader_6_wijken_1_u2fLtZ3V5uY=    INPUT RIGHT FEATURE_TYPE AttributeExposer_OUTPUT    JOIN_MODE { Inner }    JOIN_KEYS { wijkcode wijkcode AUTO }    ATTR_CONFLICT_RES { USE_LEFT }    PRESERVE_VALUES_FROM_UNJOINED_FEATURES { YES }    GEOMETRY_HANDLING { USE_LEFT }    OUTPUT { JOINED FEATURE_TYPE FeatureJoiner_JOINED        }    OUTPUT { <REJECTED> FEATURE_TYPE FeatureJoiner_<REJECTED>        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME FeatureJoiner_<Rejected> INPUT FEATURE_TYPE FeatureJoiner_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, FeatureJoiner<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
