MACRO SQLExecutor_2_DIRECTIVES APPLICATION_INTENT ReadWrite COMMAND_TIMEOUT 200 CREATE_FEATURE_TABLES_FROM_DATA Yes NAMED_CONNECTION sql_geo QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS Yes
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { SQLExecutor_2 }    INPUT  FEATURE_TYPE AttributeKeeper_3_OUTPUT    QUERY_SQL            { "@EvaluateExpression(FDIV,STRING_ENCODED,<lf>WITH<space>buurt_geom<space>AS<space><openparen><lf><space><space>SELECT<space><lf><space><space><space><space>buurtcode<comma><space><lf><space><space><space><space>SHAPE<space>AS<space>buurt_shape<lf><space><space>FROM<space>GRENZEN.CBS_BUURTKAART_2022_VERSIE3<lf><space><space>WHERE<space>buurtcode<space>=<space><apos><at>Value<openparen>buurtcode<closeparen><apos><lf><closeparen><comma><lf><lf>bomen_in_buurt<space>AS<space><openparen><lf><space><space>SELECT<space><lf><space><space><space><space>b.CROWN_AREA<lf><space><space>FROM<space>BODEM.BOMEN_KRONEN<space>b<lf><space><space>JOIN<space>buurt_geom<space>g<space><lf><space><space><space><space>ON<space>b.SHAPE.STIntersects<openparen>g.buurt_shape<closeparen><space>=<space>1<lf><closeparen><lf><lf>SELECT<space><lf><space><space><apos><at>Value<openparen>buurtcode<closeparen><apos><space>AS<space>buurtcode<comma><lf><space><space>SUM<openparen>CROWN_AREA<closeparen><space>AS<space>totaal_kroonoppervlak_m2<lf>FROM<space>bomen_in_buurt<semicolon><lf>,SQLExecutor_2)" }    READER_TYPE          { MSSQL_SPATIAL }    READER_DATASET       { "sql_geo" }    COMBINE_ATTRIBUTES   { RESULT_ONLY }    IGNORE_NULLS         { <Unused> }    COMBINE_GEOMETRY     { RESULT_ONLY }    QUERYFCT_OUTPUT      { "DATA_ONLY" }    CONTINUE_ON_READER_ERROR YES    QUERYFCT_PROPAGATE_IDS_ON_SQL_EXECUTE YES    READER_PARAMS        { $(SQLExecutor_2_DIRECTIVES) }    OUTPUT { RESULT FEATURE_TYPE SQLExecutor_2_RESULT        @SupplyAttributes(fme_feature_type,SQLExecutor_2)         }    OUTPUT { READER_ERROR FEATURE_TYPE SQLExecutor_2_<REJECTED>         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeExposer_2 }    INPUT  FEATURE_TYPE SQLExecutor_2_RESULT    OUTPUT { FEATURE_TYPE AttributeExposer_2_OUTPUT          }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {Logger_2_b3e7e895_160e_42a2_8e58_06b7f783d3d70} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME Logger_2
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Logger_2_Logger }    INPUT  FEATURE_TYPE SQLExecutor_2_<REJECTED>    OUTPUT { FEATURE_TYPE Logger_2_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Feature is:","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Logger_2 LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE Logger_2_LOGGED
# -------------------------------------------------------------------------
FACTORY_DEF {*} FeatureJoinerFactory    FACTORY_NAME { FeatureJoiner_2 }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT LEFT FEATURE_TYPE FeatureReader_7_buurten_1_vlpwnN3JaQs=    INPUT RIGHT FEATURE_TYPE AttributeExposer_2_OUTPUT    JOIN_MODE { Inner }    JOIN_KEYS { buurtcode buurtcode AUTO }    ATTR_CONFLICT_RES { USE_LEFT }    PRESERVE_VALUES_FROM_UNJOINED_FEATURES { YES }    GEOMETRY_HANDLING { USE_LEFT }    OUTPUT { JOINED FEATURE_TYPE FeatureJoiner_2_JOINED        }    OUTPUT { <REJECTED> FEATURE_TYPE FeatureJoiner_2_<REJECTED>        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
