DEFAULT_MACRO FeatureReader_6_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO FeatureReader_6_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO FeatureReader_6_COMBINE_ATTRS RESULT_ONLY";       };    ]
