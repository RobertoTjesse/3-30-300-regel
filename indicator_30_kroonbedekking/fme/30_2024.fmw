MACRO FeatureReader_7_OUTPUT_PORTS_ENCODED buurten
MACRO FeatureReader_7_DIRECTIVES ADVANCED_GROUP,,ENCODE_FEATURE_TYPE_AND_ATTR_NAMES,YES,ENFORCE_FOREIGN_KEY_INTEGRITY,YES,EXPOSE_ATTRS_GROUP,,EXPOSE_PRIMARY_KEY_ATTRIBUTE,YES,OGCGEOPACKAGE_EXPOSE_FORMAT_ATTRS,,OPEN_SINGLE_RASTER_AS_SUBDATASET,YES,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,READ_BOOLEANS_AS_YES_NO,YES,READ_NULLS,YES,READER_REPLACE_INVALID_CHARS,NO,TABLELIST,,USE_SEARCH_ENVELOPE,NO
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {NONE} == {<Unused>} ) || ( {($INTERACT)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "NONE"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO FeatureReader_7_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO FeatureReader_7_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO FeatureReader_7_COMBINE_ATTRS RESULT_ONLY";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_FeatureReader_7 @EvaluateExpression(FDIV,STRING_ENCODED,$(FME_MF_DIR_ENCODED)fme<space>input<backslash>Panden<backslash>wijkenbuurten_2023.gpkg,FeatureReader_7)}; ]
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { FeatureReader_7 }    INPUT  FEATURE_TYPE Creator_3_CREATED    $(FCTQUERY_INTERACTION_LINE)    QUERY_WHERE         { "gemeentecode<space>IN<space><openparen><apos>GM0482<apos><comma><apos>GM0613<apos><comma><apos>GM0484<apos><comma><apos>GM0489<apos><comma><apos>GM1901<apos><comma><apos>GM0502<apos><comma><apos>GM0503<apos><comma><apos>GM0505<apos><comma><apos>GM1924<apos><comma><apos>GM0512<apos><comma><apos>GM0513<apos><comma><apos>GM0518<apos><comma><apos>GM0523<apos><comma><apos>GM0531<apos><comma><apos>GM0534<apos><comma><apos>GM1963<apos><comma><apos>GM1884<apos><comma><apos>GM0537<apos><comma><apos>GM0542<apos><comma><apos>GM1931<apos><comma><apos>GM1621<apos><comma><apos>GM0546<apos><comma><apos>GM0547<apos><comma><apos>GM1916<apos><comma><apos>GM0553<apos><comma><apos>GM0556<apos><comma><apos>GM1842<apos><comma><apos>GM1978<apos><comma><apos>GM0569<apos><comma><apos>GM1930<apos><comma><apos>GM0575<apos><comma><apos>GM0579<apos><comma><apos>GM0590<apos><comma><apos>GM1926<apos><comma><apos>GM0597<apos><comma><apos>GM0603<apos><comma><apos>GM0599<apos><comma><apos>GM0606<apos><comma><apos>GM0610<apos><comma><apos>GM1525<apos><comma><apos>GM0622<apos><comma><apos>GM0626<apos><comma><apos>GM1992<apos><comma><apos>GM0627<apos><comma><apos>GM0629<apos><comma><apos>GM1783<apos><comma><apos>GM0637<apos><comma><apos>GM0638<apos><comma><apos>GM1892<apos><comma><apos>GM0642<apos><closeparen>" }    COMBINE_ATTRIBUTES  { $(FeatureReader_7_COMBINE_ATTRS) }    IGNORE_NULLS        { <Unused> }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { RESULT_ONLY }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { OGCGEOPACKAGE  }    READER_DATASET      { "$(FeatureReaderDataset_FeatureReader_7)" }    QUERYFCT_IDS        { "buurten" }    QUERYFCT_IDS_FORMAT WWJD_PARTS    READER_DIRECTIVES   { METAFILE,OGCGEOPACKAGE }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    QUERYFCT_ADD_SCHEMA { "NO" }    QUERYFCT_DEDUPE_GEOM YES    CONTINUE_ON_READER_ERROR YES    ORDER_RESULTS { "No" }    QUERYFCT_RESULT_TAGS { $(FeatureReader_7_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    READER_PARAMS_WWJD     { $(FeatureReader_7_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    OUTPUT { READER_ERROR FEATURE_TYPE FeatureReader_7_<REJECTED>           }    OUTPUT buurten FEATURE_TYPE FeatureReader_7_buurten
FACTORY_DEF * TeeFactory   FACTORY_NAME "FeatureReader_7 buurten Splitter"   INPUT FEATURE_TYPE FeatureReader_7_buurten   OUTPUT FEATURE_TYPE FeatureReader_7_buurten_0_nyZ5AwtK17w=   OUTPUT FEATURE_TYPE FeatureReader_7_buurten_1_vlpwnN3JaQs=
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME FeatureReader_7_<Rejected> INPUT FEATURE_TYPE FeatureReader_7_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, FeatureReader_7<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
