FACTORY_DEF {*} TestFactory FACTORY_NAME { TestFilter } INPUT FEATURE_TYPE TestFilter_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>type<closeparen>,TestFilter) = meer<comma><space>plas ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>type<closeparen>,TestFilter) = waterloop ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1 OR 2" OUTPUT PASSED_0 FEATURE_TYPE TestFilter_<at>Value<openparen>type<closeparen><space>=<space>meer<comma><space>plas OUTPUT FAILED FEATURE_TYPE TestFilter_<lt>UNFILTERED<gt>
