LOG_FILENAME "$(FME_MF_DIR)3_2024.log"
LOG_APPEND YES
LOG_TIMINGS YES
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING UTF-8
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "FME 2024.1.1.1 (20240820 - Build 24620 - WIN64)"
DEFAULT_MACRO DATASET_KEYWORD_GEODATABASE_FILE_1 GEODATABASE_FILE_1
# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO WORKSPACE_NAME 3_2024
MACRO FME_VIEWER_APP fmedatainspector
# -------------------------------------------------------------------------

INCLUDE [ if {[info exists env(FME_TEMP)] && [file isdirectory $env(FME_TEMP)]} {set gVisualizerTemp $env(FME_TEMP)}  elseif {[info exists env(TEMP)] && [file isdirectory $env(TEMP)]}  {set gVisualizerTemp $env(TEMP)}  elseif { $tcl_platform(platform) == "unix" } {set gVisualizerTemp "/tmp"} else {set gVisualizerTemp c:};  regsub -all {[ ,&]} {$(WORKSPACE_NAME)} {_} wsname; set gVisualizerTemp $gVisualizerTemp/${wsname}_[clock format [clock seconds] -format %H%M%S];  puts "MACRO WORKSPACE_TEMP_DIR $gVisualizerTemp"; 
MACRO VISUALIZER_FEATURE_FILE $(WORKSPACE_TEMP_DIR)/inspector.ffs
MACRO VISUALIZER_CREATE_SPATIAL_INDEX YES
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
MACRO SQLCreator_DIRECTIVES APPLICATION_INTENT ReadWrite COMMAND_TIMEOUT 30 CREATE_FEATURE_TABLES_FROM_DATA Yes NAMED_CONNECTION sql_geo QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS Yes
FACTORY_DEF {*} CreationFactory    FACTORY_NAME { SQLCreator_Creator }    OUTPUT { FEATURE_TYPE _____CREATED______ }
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { SQLCreator }    INPUT FEATURE_TYPE _____CREATED______    QUERY_SQL            { SELECT<space>t.*<lf>FROM<space>TOPOGRAFIE.BAG_PAND_PZH<space>t<lf>WHERE<space>GEBR_WOONFUNCTIE<space>=<space>1<lf><space><space>AND<space>EXISTS<space><openparen><lf><space><space><space><space>SELECT<space>1<lf><space><space><space><space>FROM<space>GRENZEN.GEMEENTE_VLAK_2022<space>g<lf><space><space><space><space>WHERE<space>g.GEMEENTE<space>=<space><apos>Hendrik-Ido-Ambacht<apos><lf><space><space><space><space><space><space>AND<space>t.SHAPE.STIntersects<openparen>g.SHAPE<closeparen><space>=<space>1<lf><space><space><closeparen><semicolon> }    COMBINE_ATTRIBUTES   RESULT_ONLY    COMBINE_GEOMETRY     RESULT_ONLY    READER_TYPE          { MSSQL_SPATIAL   }    READER_DATASET       { "sql_geo" }    READER_PARAMS        { $(SQLCreator_DIRECTIVES) }    QUERYFCT_OUTPUT      { "BASED_ON_CONNECTIONS" }    QUERYFCT_PROPAGATE_IDS_ON_SQL_EXECUTE YES    CONTINUE_ON_READER_ERROR YES    OUTPUT { RESULT FEATURE_TYPE SQLCreator_RESULT        @SupplyAttributes(fme_feature_type,SQLCreator)         }
FACTORY_DEF * BranchingFactory   FACTORY_NAME "SQLCreator_RESULT Brancher -1 5"   INPUT FEATURE_TYPE SQLCreator_RESULT   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
# -------------------------------------------------------------------------
MACRO SQLCreator_2_DIRECTIVES APPLICATION_INTENT ReadWrite COMMAND_TIMEOUT 30 CREATE_FEATURE_TABLES_FROM_DATA Yes NAMED_CONNECTION sql_geo QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS Yes
FACTORY_DEF {*} CreationFactory    FACTORY_NAME { SQLCreator_2_Creator }    OUTPUT { FEATURE_TYPE _____CREATED______ }
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { SQLCreator_2 }    INPUT FEATURE_TYPE _____CREATED______    QUERY_SQL            { WITH<space>gemeente_geom<space>AS<space><openparen><lf><space><space>SELECT<space>SHAPE<lf><space><space>FROM<space>GRENZEN.GEMEENTE_VLAK_2022<lf><space><space>WHERE<space>GEMEENTE<space>=<space><apos>Hendrik-Ido-Ambacht<apos><lf><closeparen><comma><lf><lf>bomen_in_gemeente<space>AS<space><openparen><lf><space><space>SELECT<space>top<space>1000<space>b.*<lf><space><space>FROM<space>BODEM.BOMEN_KRONEN<space>b<lf><space><space>JOIN<space>gemeente_geom<space>g<lf><space><space><space><space>ON<space>b.SHAPE.STIntersects<openparen>g.SHAPE<closeparen><space>=<space>1<lf><closeparen><comma><lf><lf>bomen_buffer<space>AS<space><openparen><lf><space><space>SELECT<space>b.*<comma><space>b.SHAPE.STBuffer<openparen>25<closeparen><space>AS<space>buffer_geom<lf><space><space>FROM<space>bomen_in_gemeente<space>b<lf><closeparen><lf><lf>SELECT<space>p.*<lf>FROM<space>TOPOGRAFIE.BAG_PAND_PZH<space>p<lf>JOIN<space>gemeente_geom<space>g<lf><space><space>ON<space>p.SHAPE.STIntersects<openparen>g.SHAPE<closeparen><space>=<space>1<lf>JOIN<space>bomen_buffer<space>bb<lf><space><space>ON<space>p.SHAPE.STIntersects<openparen>bb.buffer_geom<closeparen><space>=<space>1<lf>WHERE<space>p.GEBR_WOONFUNCTIE<space>=<space>1<semicolon><lf> }    COMBINE_ATTRIBUTES   RESULT_ONLY    COMBINE_GEOMETRY     RESULT_ONLY    READER_TYPE          { MSSQL_SPATIAL   }    READER_DATASET       { "sql_geo" }    READER_PARAMS        { $(SQLCreator_2_DIRECTIVES) }    QUERYFCT_OUTPUT      { "BASED_ON_CONNECTIONS" }    QUERYFCT_PROPAGATE_IDS_ON_SQL_EXECUTE YES    CONTINUE_ON_READER_ERROR YES    OUTPUT { RESULT FEATURE_TYPE SQLCreator_2_RESULT        @SupplyAttributes(fme_feature_type,SQLCreator_2)         }
FACTORY_DEF * BranchingFactory   FACTORY_NAME "SQLCreator_2_RESULT Brancher -1 8"   INPUT FEATURE_TYPE SQLCreator_2_RESULT   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
# -------------------------------------------------------------------------
Tcl2 proc Creator_CoordSysRemover {} {   global FME_CoordSys;   set FME_CoordSys {}; }
MACRO Creator_XML     NOT_ACTIVATED
MACRO Creator_GEOJSON NOT_ACTIVATED
INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO Creator_XML *} } ]
INCLUDE [ if { {Geometry Object} == {GeoJSON} } {            puts {MACRO Creator_GEOJSON *} } ]
FACTORY_DEF {$(Creator_XML)} CreationFactory    FACTORY_NAME { Creator_XML_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______        @Geometry(FROM_ENCODED_STRING,<lt>?xml<space>version=<quote>1.0<quote><space>encoding=<quote>US_ASCII<quote><space>standalone=<quote>no<quote><space>?<gt><lt>geometry<space>dimension=<quote>2<quote><gt><lt>null<solidus><gt><lt><solidus>geometry<gt>) }
FACTORY_DEF {$(Creator_GEOJSON)} CreationFactory    FACTORY_NAME { Creator_GEOJSON_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______ 	   @SupplyAttributes(ENCODED,__GeoJSONCreatorTemp__,<Unused>)        @JSONGeometry(FROM_ATTRIBUTE,GEOJSON,__GeoJSONCreatorTemp__, PREFER_ERROR_OVER_REJECTION) 	   @RemoveAttributes(__GeoJSONCreatorTemp__) }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Creator_Cloner }    INPUT FEATURE_TYPE _____CREATED______        @Tcl2(Creator_CoordSysRemover)        @CoordSys()    NUMBER_OF_COPIES { 1 }    COPY_NUMBER_ATTRIBUTE { "_creation_instance" }    OUTPUT { FEATURE_TYPE Creator_CREATED        fme_feature_type Creator         }
FACTORY_DEF * BranchingFactory   FACTORY_NAME "Creator_CREATED Brancher -1 11"   INPUT FEATURE_TYPE Creator_CREATED   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
