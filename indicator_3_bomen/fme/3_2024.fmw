MACRO SQLExecutor_4_DIRECTIVES APPLICATION_INTENT ReadWrite COMMAND_TIMEOUT 30 CREATE_FEATURE_TABLES_FROM_DATA Yes NAMED_CONNECTION sql_geo QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS Yes
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { SQLExecutor_4 }    INPUT  FEATURE_TYPE Sampler_3_SAMPLED_0_P+/u3Cijnjc=    QUERY_SQL            { "WITH<space>...<space>--<space>buffer<comma><space>panden<comma><space>tree<space>centroids<lf><lf>SELECT<space>TOP<space>3<space>WITH<space>TIES<space><lf><space><space>b.tree_id<comma><lf><space><space>p.pand_id<comma><lf><space><space>v.vertex_geom<comma><lf><space><space>b.SHAPE.STCentroid<openparen><closeparen>.STDistance<openparen>v.vertex_geom<closeparen><space>AS<space>dist<lf>FROM<space>bomen_buffer<space>b<lf>JOIN<space>panden_vertices<space>v<lf><space><space>ON<space>b.buffer_geom.STIntersects<openparen>v.vertex_geom<closeparen><space>=<space>1<lf>JOIN<space>panden<space>p<lf><space><space>ON<space>v.pand_id<space>=<space>p.pand_id<lf>ORDER<space>BY<space><lf><space><space>ROW_NUMBER<openparen><closeparen><space>OVER<space><openparen>PARTITION<space>BY<space>b.tree_id<comma><space>v.pand_id<space>ORDER<space>BY<space>dist<closeparen><lf>" }    READER_TYPE          { MSSQL_SPATIAL }    READER_DATASET       { "sql_geo" }    COMBINE_ATTRIBUTES   { RESULT_ONLY }    IGNORE_NULLS         { <Unused> }    COMBINE_GEOMETRY     { RESULT_ONLY }    QUERYFCT_OUTPUT      { "DATA_ONLY" }    CONTINUE_ON_READER_ERROR YES    QUERYFCT_PROPAGATE_IDS_ON_SQL_EXECUTE YES    READER_PARAMS        { $(SQLExecutor_4_DIRECTIVES) }    OUTPUT { RESULT FEATURE_TYPE SQLExecutor_4_RESULT        @SupplyAttributes(fme_feature_type,SQLExecutor_4)         }
