en><space>AS<space>boom_ids<lf>FROM<space>TOPOGRAFIE.BAG_PAND_PZH<space>p<lf>LEFT<space>JOIN<space>boom_pand_match<space>bpm<lf><space><space>ON<space>p.OBJECTID<space>=<space>bpm.pand_id<lf>JOIN<space>gemeente_geom<space>g<lf><space><space>ON<space>p.SHAPE.Filter<openparen>g.SHAPE<closeparen><space>=<space>1<lf><space><space>AND<space>p.SHAPE.STIntersects<openparen>g.SHAPE<closeparen><space>=<space>1<lf>WHERE<space>p.GEBR_WOONFUNCTIE<space>=<space>1<lf>GROUP<space>BY<space>p.OBJECTID<semicolon><lf>,SQLExecutor_2)" }    READER_TYPE          { MSSQL_SPATIAL }    READER_DATASET       { "sql_geo" }    COMBINE_ATTRIBUTES   { RESULT_ONLY }    IGNORE_NULLS         { <Unused> }    COMBINE_GEOMETRY     { RESULT_ONLY }    QUERYFCT_OUTPUT      { "DATA_ONLY" }    CONTINUE_ON_READER_ERROR YES    QUERYFCT_PROPAGATE_IDS_ON_SQL_EXECUTE YES    READER_PARAMS        { $(SQLExecutor_2_DIRECTIVES) }    OUTPUT { RESULT FEATURE_TYPE SQLExecutor_2_RESULT        @SupplyAttributes(fme_feature_type,SQLExecutor_2)         }
