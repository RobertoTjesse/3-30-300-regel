INCLUDE [    if {{NoReduction} == {NoReduction} &&        {NO_THINNING} == {NO_THINNING}} {       puts "MACRO Sightlines_2_52ab3a03_c399_492a_a815_34fffa4662bb1_LARGE_GEOMETRY_DATA_STORAGE REFERENCE";    } else {       puts "MACRO Sightlines_2_52ab3a03_c399_492a_a815_34fffa4662bb1_LARGE_GEOMETRY_DATA_STORAGE FULL";    }; ]
