MACRO GeometryReplacer_5_Function
MACRO GeometryReplacer_5_RemoveTempAttr
MACRO GeometryReplacer_5_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>sightline<closeparen>,GeometryReplacer_5)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO GeometryReplacer_5_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO GeometryReplacer_5_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{Yes} == {Yes} } {                puts "MACRO GeometryReplacer_5_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{mssql} == {fmebinary} } {               puts "MACRO GeometryReplacer_5_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{mssql} == {fmehex} } {               puts "MACRO GeometryReplacer_5_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{mssql} == {fmexml} } {               puts "MACRO GeometryReplacer_5_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {fmexmlencoded} } {               puts "MACRO GeometryReplacer_5_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{mssql} == {polyline} } {               puts "MACRO GeometryReplacer_5_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{mssql} == {wkt} } {               puts "MACRO GeometryReplacer_5_Function @OGCGeometry(from_attribute,mssql,\"$geomSrcAttr\",<Unused>)";           } elseif {{mssql} == {wkb} ||                      {mssql} == {wkbhex} } {               puts "MACRO GeometryReplacer_5_Function @OGCGeometry(from_attribute,mssql,\"$geomSrcAttr\")";           } elseif {{mssql} == {GEOJSON} ||                     {mssql} == {ESRIJSON} } {               puts "MACRO GeometryReplacer_5_Function @JSONGeometry(FROM_ATTRIBUTE,mssql,\"$geomSrcAttr\")";           } elseif {{mssql} == {GEORSS} } {               puts "MACRO GeometryReplacer_5_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {KML} } {               puts "MACRO GeometryReplacer_5_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {GML} } {               puts "MACRO GeometryReplacer_5_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{mssql} == {geohash} } {               puts "MACRO GeometryReplacer_5_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{mssql} == {ogeosms} ||                     {mssql} == {geosms}  ||                     {mssql} == {geo} } {               puts "MACRO GeometryReplacer_5_Function @OGCGeometry(from_attribute,mssql,\"$geomSrcAttr\")";           } elseif {{mssql} == {mgrs}} {               puts "MACRO GeometryReplacer_5_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>sightline<closeparen>,GeometryReplacer_5)\")"           } elseif {{mssql} == {mssql} } {               puts "MACRO GeometryReplacer_5_Function @SerializeGeometry(from_attribute,mssql,\"$geomSrcAttr\",geometry)";           } elseif {{mssql} == {iso6709} } {               puts "MACRO GeometryReplacer_5_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {qlikmaps} } {               puts "MACRO GeometryReplacer_5_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
