# -------------------------------------------------------------------------
# First determine which function we are going to be using -- we can do
# this statically at parse time for efficiency sake
MACRO GeometryReplacer_6_SetTempAttr
MACRO GeometryReplacer_6_Function
MACRO GeometryReplacer_6_RemoveTempAttr
MACRO GeometryReplacer_6_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>line_outside_pand<closeparen>,GeometryReplacer_6)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO GeometryReplacer_6_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO GeometryReplacer_6_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{Yes} == {Yes} } {                puts "MACRO GeometryReplacer_6_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{mssql} == {fmebinary} } {               puts "MACRO GeometryReplacer_6_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{mssql} == {fmehex} } {               puts "MACRO GeometryReplacer_6_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{mssql} == {fmexml} } {               puts "MACRO GeometryReplacer_6_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {fmexmlencoded} } {               puts "MACRO GeometryReplacer_6_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{mssql} == {polyline} } {               puts "MACRO GeometryReplacer_6_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{mssql} == {wkt} } {               puts "MACRO GeometryReplacer_6_Function @OGCGeometry(from_attribute,mssql,\"$geomSrcAttr\",<Unused>)";           } elseif {{mssql} == {wkb} ||                      {mssql} == {wkbhex} } {               puts "MACRO GeometryReplacer_6_Function @OGCGeometry(from_attribute,mssql,\"$geomSrcAttr\")";           } elseif {{mssql} == {GEOJSON} ||                     {mssql} == {ESRIJSON} } {               puts "MACRO GeometryReplacer_6_Function @JSONGeometry(FROM_ATTRIBUTE,mssql,\"$geomSrcAttr\")";           } elseif {{mssql} == {GEORSS} } {               puts "MACRO GeometryReplacer_6_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {KML} } {               puts "MACRO GeometryReplacer_6_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {GML} } {               puts "MACRO GeometryReplacer_6_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{mssql} == {geohash} } {               puts "MACRO GeometryReplacer_6_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{mssql} == {ogeosms} ||                     {mssql} == {geosms}  ||                     {mssql} == {geo} } {               puts "MACRO GeometryReplacer_6_Function @OGCGeometry(from_attribute,mssql,\"$geomSrcAttr\")";           } elseif {{mssql} == {mgrs}} {               puts "MACRO GeometryReplacer_6_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>line_outside_pand<closeparen>,GeometryReplacer_6)\")"           } elseif {{mssql} == {mssql} } {               puts "MACRO GeometryReplacer_6_Function @SerializeGeometry(from_attribute,mssql,\"$geomSrcAttr\",geometry)";           } elseif {{mssql} == {iso6709} } {               puts "MACRO GeometryReplacer_6_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{mssql} == {qlikmaps} } {               puts "MACRO GeometryReplacer_6_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { GeometryReplacer_6_Rejector }    COMMAND_PARM_EVALUATION SINGLE_PASS    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    INPUT  FEATURE_TYPE AttributeExposer_2_OUTPUT    $(GeometryReplacer_6_SetTempAttr)    FUNCTION_DEFINITION { $(GeometryReplacer_6_Function) }    OUTPUT { COMPLETE FEATURE_TYPE GeometryReplacer_6_OUTPUT        $(GeometryReplacer_6_RemoveTempAttr) $(GeometryReplacer_6_RemoveSourceAttr) }
